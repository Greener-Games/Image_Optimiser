{
  "name": "@greener-games/image-optimiser",
  "version": "1.0.3",
  "description": "Vue 3 plugin for caching and optimizing images",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "prepublishOnly": "npm run build"
  },
  "author": "Greener Games",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greener-Games/Image-Optimiser.git",
    "directory": "plugins/@greener-games/image-Optimiser"
  },
  "dependencies": {
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  }
}
